
#     cp .env.example .env
#
# Every value below is also the built-in default in
# src/heartbeat_monitoring/config/settings.py, so an empty .env still works
# against the stock docker-compose stack

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heart-rate-readings
KAFKA_CLIENT_ID=heartbeat-producer
KAFKA_CONSUMER_GROUP=heartbeat-consumer-group

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heartbeat_monitoring
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=heartbeat_password

# --- Simulation ---
# How many synthetic customers to generate for (CUST_001 ... CUST_00N).
NUMBER_OF_CUSTOMERS=5
# Seconds between generation rounds; one round emits one event per customer.
GENERATION_INTERVAL_SECONDS=1.0
# Bounds of the "plausible normal" generated range.
MIN_HEART_RATE=55
MAX_HEART_RATE=100
# Share of readings deliberately generated as outliers, so the
# anomaly-detection path is actually exercised during a demo run.
ANOMALY_PROBABILITY=0.05

# --- Anomaly classification ---
# Business-rule thresholds, not medical ones. Inclusive bounds of the normal
# band: a reading equal to a threshold is NORMAL, only strictly-beyond values
# are flagged LOW or HIGH.
ANOMALY_LOW_THRESHOLD=50
ANOMALY_HIGH_THRESHOLD=120

# --- Observability ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Host port for the Grafana dashboard. Read by docker-compose only, not by the
# application. Change it if something else on your machine holds 3000.
GRAFANA_PORT=3000
