# Copy to .env and adjust if you're not using the default docker-compose setup.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=heartbeat-stream

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heartbeat_db
POSTGRES_USER=hbuser
POSTGRES_PASSWORD=hbpassword

NUM_CUSTOMERS=5
MESSAGE_INTERVAL_SECONDS=0.5
ANOMALY_PROBABILITY=0.03
VALID_HR_LOW=40
VALID_HR_HIGH=200
